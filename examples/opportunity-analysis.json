  "sections": [
    {
      "title": "Prepare & Theme",
      "items": [
        "Open Microsoft Power BI Desktop optimized for Report Server (January 2026, build 2.150.5353.0).",
        "Navigate to View > Themes > Browse for themes and import 'veterans-affairs.theme.json'.",
        "Verify canvas dimensions are set to standard 4:3 ratio (1024 x 768 px).",
        "Verify white background (#FFFFFF) and 5px rounded visual borders with #A9AEB1 outline."
      ]
    },
    {
      "title": "Quadrant Construction",
      "items": [
        "Construct Quadrant 1 (Opportunity Count Overview) at [12, 10, 484, 354] with Partner Driven slicer, 31 callout, regional pie chart, and stage breakdown bars.",
        "Construct Quadrant 2 (Revenue Analysis) at [518, 10, 494, 354] with regional revenue pie chart, sales stage columns ($40M max), KPI summary cards ($109M / $48.9M / 31), and avg revenue bars.",
        "Construct Quadrant 3 (Upcoming Opportunities By Month) at [12, 384, 484, 374] with upcoming KPI cards, factored revenue by size columns, monthly slicer, and 100% stacked column stage breakdown.",
        "Construct Quadrant 4 (Opportunity Count by Region and Stage) at [518, 384, 494, 374] with regional pie chart, stage breakdown bars, partner-driven split (18 vs 13), and size distribution bars."
      ]
    },
    {
      "title": "Colorblind Accessibility & Polish",
      "items": [
        "Verify colorblind accessibility compliance using the deuteranopia-friendly palette (Navy #005EA2, Amber #E5A000, Cyan #00BDE3, Purple #54278F, Rust #D54309).",
        "Ensure Georgia serif titles are applied to all four quadrant banners in #162E51.",
        "Format currency axes on revenue charts to display in Millions ($M).",
        "Test cross-filtering across partner-driven slicer and calendar month slicer."
      ]
    }
  ],
  "acceptance": [
    "Theme JSON imports with full USWDS/VADS deuteranopia-accessible color palette.",
    "Report canvas renders at 1024 x 768 px with clean 4-quadrant layout and zero visual overlaps.",
    "All 26 visuals maintain exact placement bounds within their respective quadrant frames.",
    "KPI cards accurately reflect $109,153,825 total revenue and $48,957,216 factored revenue.",
    "Pie and donut charts display 3 distinct regional slices with accessible contrast.",
    "Clustered columns and bars align with the 11 theme dataColors across all sales stages and deal sizes."
  ]
}
